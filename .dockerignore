# Виртуальное окружение — Cog сам ставит зависимости из cog.yaml
.venv/
venv/

# Сырой датасет — тяжёлый, внутри образа не нужен
data/raw/

# Промежуточные данные — тоже не нужны в образе
data/processed/

# Кэш моделей — скачается при первом запуске на Replicate
.cache/

# Прочее
__pycache__/
*.pyc
.env
.git/
logs/
